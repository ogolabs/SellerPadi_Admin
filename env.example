# -----------------------------------------------------------------------------
# SellerPadi Admin — Environment Configuration Template
# Copy this file to .env.local and populate the values for your environment.
# -----------------------------------------------------------------------------
NODE_ENV=development
# Network Configuration ("testnet" or "mainnet")
NEXT_PUBLIC_NETWORK=testnet

# MongoDB Connection String (scoped per environment in Vercel)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/SellerPadi?retryWrites=true&w=majority

# Administrative Authentication Gate
# Google Identity Services (GIS) Client ID for admin Google Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 32+ character random secret for signing admin session JWTs
ADMIN_SESSION_SECRET=SellerPadi_admin_internal_secret_key_change_in_production_min_32_chars
# Comma-separated list of authorized administrator email addresses
ADMIN_EMAILS=support@sellerpadi.com,ceo@sellerpadi.com

# Internal Frontend URL (used by Admin to query relayer reconcile sweeps)
FRONTEND_INTERNAL_URL=http://localhost:3000

# Shared Cron & Relayer Secret (must match frontend CRON_SECRET)
CRON_SECRET=SellerPadi_cron_internal_secret_change_in_production

# Blockchain Infrastructure & Relayer (Avalanche C-Chain)
# Primary Avalanche C-Chain relayer account address for balance and nonce telemetry
RELAYER_ADDRESS=0xED0fa5f6749b398DcD10A1E643cC0aBc3096bEa4
# Optional Ankr premium API key for enhanced RPC speed
ANKR_API_KEY=

# Email Dispatch via ZeptoMail (used to deliver Admin 6-digit OTP passcodes)
ZEPTOMAIL_SEND_TOKEN=Zoho-enczapikey-placeholder
ZEPTOMAIL_FROM_EMAIL=no-reply@sellerpadi.com
ZEPTOMAIL_FROM_NAME=SellerPadi Mission Control

# Termii SMS Token API (OTP Deliveries)
TERMII_API_KEY=
TERMII_BASE_URL=https://v4.api.termii.com
TERMII_SENDER_ID=SellerPadi
TERMII_CHANNEL=generic

# Didit v3 KYC Verification
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_MONTHLY_CHECK_LIMIT=500
DIDIT_MONTHLY_CHECK_LIMIT=500
